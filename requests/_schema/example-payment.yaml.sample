# Example only — not validated by CI (filename doesn't end in .yaml).
# Copy this into requests/<your-team>/<name>.yaml and edit.
apiVersion: dbplatform/v1
kind: DatabaseRequest
metadata:
  name: payment
  team: payment-team
  cost_center: CC-1234
  ticket: CHG-2026-0412
spec:
  cloud: azure
  env: prod
  engine: postgres-flexible
  server: psql-acme-prod-sea-shared01
  data_classification: confidential
  tier: tier1
  databases:
    - name: payment
      connection_limit: 80
      extensions: [pgcrypto, uuid-ossp]
      schemas: [app, audit]
  access:
    apps:
      - principal: mi-payment-api
        object_id: "00000000-0000-0000-0000-000000000000"
        role: rw
      - principal: mi-payment-report
        object_id: "00000000-0000-0000-0000-000000000000"
        role: ro
    migration:
      principal: mi-payment-migrator
      object_id: "00000000-0000-0000-0000-000000000000"
    engineers:
      - group: grp-payment-db-eng-ro
        object_id: "00000000-0000-0000-0000-000000000000"
        role: eng_ro
      - group: grp-payment-db-eng-rw
        object_id: "00000000-0000-0000-0000-000000000000"
        role: eng_rw
