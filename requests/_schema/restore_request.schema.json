{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://db-platform/schema/restore_request.schema.json",
  "title": "RestoreRequest",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": { "const": "dbplatform/v1" },
    "kind": { "const": "RestoreRequest" },
    "metadata": {
      "type": "object",
      "required": ["ticket", "requested_by", "reason"],
      "additionalProperties": false,
      "properties": {
        "ticket": { "type": "string" },
        "requested_by": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "required": ["cloud", "env", "server", "mode", "restore_time_utc", "cutover", "ttl_hours"],
      "additionalProperties": false,
      "properties": {
        "cloud": { "enum": ["aws", "azure"] },
        "env": { "enum": ["dev", "uat", "prod"] },
        "server": { "type": "string" },
        "mode": { "enum": ["full-server", "single-db", "drill"] },
        "database": { "type": "string" },
        "restore_time_utc": { "type": "string", "format": "date-time" },
        "cutover": { "enum": ["manual", "dns-swap", "rename"] },
        "ttl_hours": { "type": "integer", "minimum": 1, "maximum": 168 }
      },
      "if": { "properties": { "mode": { "const": "single-db" } } },
      "then": { "required": ["database"] }
    }
  }
}
